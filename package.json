{
  "name": "praca-inzynierska",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.21",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22",
    "@types/react": "~19.3.0",
    "firebase-tools": "15.37.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:unit": "jest --config jest.config.cjs --selectProjects unit --runInBand",
    "test:ui": "jest --config jest.config.cjs --selectProjects ui --runInBand",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --runInBand --coverage",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-praca-tests --config firebase.tests.json \"jest --config jest.integration.config.cjs --runInBand\"",
    "test:all": "npm run test && npm run test:integration",
    "test:e2e": "node scripts/run-e2e.cjs",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
