rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function active() {
      return request.auth != null && !exists(/databases/$(database)/documents/accountStatus/$(request.auth.uid));
    }
    function member(teamId) {
      return teamId is string && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
    }
    function teamOwner(teamId) {
      return teamId is string && get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
    }
    function validMember(profile) {
      return profile is map && profile.keys().hasOnly(['name', 'nickname'])
        && profile.name is string && profile.name.size() > 0 && profile.name.size() <= 201
        && profile.nickname is string && profile.nickname.size() <= 50;
    }
    function validTeam(data) {
      return data.keys().hasAll(['name', 'description', 'ownerId', 'memberIds', 'members', 'createdAt'])
        && data.keys().hasOnly(['name', 'description', 'ownerId', 'memberIds', 'members', 'createdAt', 'lastJoinInvite'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.description is string && data.description.size() <= 500
        && data.memberIds is list && data.memberIds.size() > 0 && data.memberIds.size() <= 50
        && data.ownerId in data.memberIds && data.members is map
        && data.members.keys().hasAll(data.memberIds) && data.members.keys().hasOnly(data.memberIds);
    }
    function acceptedInvite(teamId, code) {
      let invite = getAfter(/databases/$(database)/documents/teamInvitations/$(code)).data;
      return invite.teamId == teamId && invite.status == 'accepted' && invite.acceptedBy == request.auth.uid;
    }
    function canReadShared(data) {
      return data.get('teamId', null) is string && member(data.teamId);
    }
    function validSharing(uid, previousTeam) {
      return !('sourceId' in request.resource.data)
        && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == uid)
        && (!('teamId' in request.resource.data) ||
          (request.resource.data.teamId is string && request.resource.data.teamId.size() > 0
            && request.resource.data.ownerId == uid
            && (request.resource.data.teamId == previousTeam || member(request.resource.data.teamId))));
    }
    match /users/{uid}/{collection}/{document} {
      allow read: if active() && collection in ['projects', 'events', 'migrations']
        && (request.auth.uid == uid || (collection == 'projects' && canReadShared(resource.data)));
      allow create: if active() && request.auth.uid == uid
        && (collection in ['events', 'migrations'] || (collection == 'projects' && validSharing(uid, '')));
      allow update: if active() && (
        (request.auth.uid == uid && (collection in ['events', 'migrations'] ||
          (collection == 'projects' && validSharing(uid, resource.data.get('teamId', ''))))) ||
        (collection == 'projects' && resource.data.get('ownerId', null) == uid && canReadShared(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasks'])
          && request.resource.data.tasks is list)
      );
      allow delete: if active() && request.auth.uid == uid && collection in ['projects', 'events', 'migrations'];
    }
    // Required for collectionGroup('projects') queries constrained by teamId.
    match /{path=**}/projects/{projectId} {
      allow read: if active() && canReadShared(resource.data);
    }
    match /teams/{teamId} {
      allow get: if active() && (!exists(/databases/$(database)/documents/teams/$(teamId)) || member(teamId));
      allow list: if active() && request.auth.uid in resource.data.memberIds;
      allow create: if active() && validTeam(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && validMember(request.resource.data.members[request.auth.uid])
        && request.resource.data.createdAt == request.time
        && !('lastJoinInvite' in request.resource.data);
      allow update: if active() && validTeam(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt && (
          // Owners may edit team metadata and remove participants, never add them silently.
          (resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'memberIds', 'members'])
            && request.resource.data.memberIds.hasOnly(resource.data.memberIds)
            && request.resource.data.members.diff(resource.data.members).addedKeys().size() == 0
            && request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0) ||
          // A participant can leave without changing anyone else's identity.
          (request.auth.uid in resource.data.memberIds && request.auth.uid != resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
            && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])) ||
          // Joining requires consuming a pending invitation atomically.
          (!(request.auth.uid in resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'lastJoinInvite'])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
            && validMember(request.resource.data.members[request.auth.uid])
            && request.resource.data.lastJoinInvite is string
            && get(/databases/$(database)/documents/teamInvitations/$(request.resource.data.lastJoinInvite)).data.status == 'pending'
            && acceptedInvite(teamId, request.resource.data.lastJoinInvite))
        );
      allow delete: if active() && resource.data.ownerId == request.auth.uid;
    }
    match /teamInvitations/{code} {
      allow get: if active() && exists(/databases/$(database)/documents/teams/$(resource.data.teamId))
        && (teamOwner(resource.data.teamId) || resource.data.acceptedBy == request.auth.uid ||
          (resource.data.status == 'pending' && resource.data.expiresAt > request.time));
      allow list: if active() && teamOwner(resource.data.teamId);
      allow create: if active() && code.size() == 20 && teamOwner(request.resource.data.teamId)
        && request.resource.data.keys().hasOnly(['teamId', 'teamName', 'ownerId', 'status', 'acceptedBy', 'createdAt', 'expiresAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.teamName == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.name
        && request.resource.data.status == 'pending' && request.resource.data.acceptedBy == null
        && request.resource.data.createdAt == request.time && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
      allow update: if active() && (
        (teamOwner(resource.data.teamId) && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'revoked') ||
        (resource.data.status == 'pending' && resource.data.expiresAt > request.time
          && !(request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
          && request.resource.data.status == 'accepted' && request.resource.data.acceptedBy == request.auth.uid
          && request.resource.data.acceptedAt == request.time
          && request.auth.uid in getAfter(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.memberIds
          && getAfter(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.lastJoinInvite == code)
      );
    }
  }
}
